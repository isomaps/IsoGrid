{
  "name": "@isomaps/isogrid",
  "version": "0.4.0",
  "description": "Grille de données headless-based, framework-agnostique : colonnes épinglées, filtres par colonne, sidebar, export Excel, modèle de lignes client ou serveur.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/isogrid.js",
  "module": "./dist/isogrid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/isogrid.js"
    },
    "./style.css": "./dist/isogrid.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:vendor": "vite build --config vite.vendor.config.ts",
    "install:laravel": "./install.sh",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@tanstack/store": "^0.11.1",
    "@tanstack/table-core": "^9.1.2"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/isomaps/IsoGrid.git"
  }
}
